[flake8]
# Some sane defaults for the code style checker flake8
max_line_length = 120
extend_ignore = E203, E266, E501, W503, E221
# ^  Black-compatible
#    E203 and W503 have edge cases handled by black
max-complexity = 18
select = B,C,E,F,W,T4,B9
exclude =
    .tox
    build
    dist
    .eggs
    docs/conf.py
    submodules
