# ═══════════════════════════════════════════════════════════════════
# HDF5 Input -- Benchmark Config Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file, edit the input path, and comment out anything you
# don't need. Every available field and option is shown below.
#
# Supported HDF5 layouts:
#   Columnar:  /channels/<label> datasets + optional /samplestamp
#   Rowgroup:  /data matrix (N, C) + optional /samplestamp
#
# If the HDF5 file has no samplestamp dataset, a 0-based index is
# generated automatically during ingest.
#
# Usage:
#   python benchmark/scripts/run_benchmarks.py --config my_config.yaml
# ═══════════════════════════════════════════════════════════════════

# --- Input ----------------------------------------------------------
studies:
  - name: "my_hdf5_recording"
    input: "/path/to/my_recording.h5"      # <-- EDIT THIS (.h5, .hdf5, .he5)
    # sample_freq: 256                      # Optional if HDF5 has sample_freq attribute

# --- Core Benchmarks ------------------------------------------------
benchmarks:
  - random_access                           # A: Windowed read at various file positions
  - channel_subset                          # B: Read a subset of channels (columnar advantage)
  - remontage                               # C: Read + bipolar montage computation
  - filter_pipeline                         # D: Full-study chunked read + bandpass/notch DSP
  - window_scaling                          # E: Throughput vs window size (10s to 1hr)

# --- Output Variants ------------------------------------------------
# Each entry generates one file from the canonical Parquet and runs
# all core benchmarks on it. Comment out or duplicate entries as needed.
variants:
  - format: parquet
    row_group_minutes: 5                    # Row group size in minutes of data
    dtype: float32                          # float32 | int32
    compression: lz4                        # lz4 | snappy | zstd | none

  - format: parquet
    row_group_minutes: 30
    dtype: float32
    compression: lz4

  - format: parquet
    row_group_minutes: 60
    dtype: float32
    compression: lz4

  - format: hdf5
    layout: columnar                        # columnar | rowgroup
    chunk_minutes: 5                        # Chunk size in minutes of data
    dtype: float32                          # float32
    compression: lz4                        # lz4 | gzip | none

  - format: hdf5
    layout: columnar
    chunk_minutes: 30
    dtype: float32
    compression: lz4

  - format: hdf5
    layout: columnar
    chunk_minutes: 60
    dtype: float32
    compression: lz4

  - format: hdf5
    layout: rowgroup
    chunk_minutes: 30
    dtype: float32
    compression: lz4

  - format: edf                             # Always 16-bit quantized

# --- Benchmark Parameters -------------------------------------------
repetitions: 3
default_window: 60
window_sizes: [10, 30, 60, 300, 900, 1800, 3600]
read_positions: [0.0, 0.5, 0.75, 0.95]
channel_subsets: [4, 10]

# --- Parquet-Specific Investigations (optional) ---------------------
parquet_investigations:
  enabled: true
  compression:
    codecs: [none, snappy, zstd, lz4]
    zstd_level: 3
  precision_loss: true
  int32_storage: true
  remote_query:
    enabled: false
    remote_url: "https://your-storage.blob.core.windows.net/container/file.parquet"

parquet_compression:
  - codec: "none"
  - codec: "snappy"
  - codec: "zstd"
    level: 3
  - codec: "lz4"

# --- Tuned Comparison (optional) ------------------------------------
tuned_comparison:
  enabled: true
  block_sizes_minutes: [5, 10, 20, 30, 60, 120]
  compression: lz4
  dtype: float32

tuned_block_sizes_minutes: [5, 10, 20, 30, 60, 120]

# --- Output ---------------------------------------------------------
cache_dir: ".benchmark_cache"
# output: "results/my_benchmark_results.json"

